{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SatConverter",
  "version": "0.1.0",
  "identifier": "org.pandul.satconverter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.coingecko.com; img-src 'self' data:; font-src 'self'; style-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "SatConverter",
        "width": 424,
        "height": 640,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#0B0C0F"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Loïc Morel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
